 "_about": {
  "zoo_commit": "96e0bc1f7965bedc17b36ab1ea5403e79e513cf1",
  "zoo_repo": "https://github.com/john-rocky/LiteRT-Models",
  "sample_path": "<sample>/app/src/main/assets/{test_image.jpg|sample.jpg|test_image.png}",
  "norm": {
   "imagenet": "(x/255 - [0.485,0.456,0.406]) / [0.229,0.224,0.225]",
   "unit": "x/255",
   "minus1to1": "x/127.5 - 1",
   "minus_half": "x/255 - 0.5",
   "raw255": "x",
   "mmpose255": "(x - [123.675,116.28,103.53]) / [58.395,57.12,57.375]",
   "yolact_bgr": "BGR, (x - [103.94,116.78,123.68]) / [57.38,57.12,58.40]"
  },
  "geometry": {
   "stretch": "resize to (W, H)",
   "center_square": "centre square crop, then resize",
   "center_3x4": "centre crop to W:H = 3:4, then resize",
   "letterbox_white": "keep the aspect, pad white",
   "letterbox_black": "keep the aspect, pad black",
   "short256_center224": "short side to 256, centre crop 224",
   "line_crop48": "crop box, height 48 keeping the aspect (width <= 320), left-aligned, the rest raw 0"
  },
  "source": "read from the zoo's Android code by an Explore agent on 2026-11-06 (every input carries its path:line); spot-checked by hand: places365, migan, vrwkv, dewarp, sam2 decoder layout, the D-FINE graph A -> B glue"
 },
